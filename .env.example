# Public Web URL used by sitemap, robots.txt, canonical URLs, and social metadata
# SITE_URL=https://your-domain.example
# Sitemap cache TTL in seconds (default 3600)
# SITEMAP_REVALIDATE_SECONDS=3600

DB_TYPE=sqlite
CONNECTION_STRING=Data Source=/data/opendeepwiki.db
JWT_SECRET_KEY=change-this-to-a-long-random-secret
LOCAL_IMPORT_ROOT=/host/home/zhangruibo

CHAT_API_KEY=your-chat-api-key
ENDPOINT=https://api.openai.com/v1
CHAT_REQUEST_TYPE=OpenAI

WIKI_CATALOG_MODEL=gpt-4o
WIKI_CATALOG_ENDPOINT=https://api.openai.com/v1
WIKI_CATALOG_API_KEY=your-catalog-api-key
WIKI_CATALOG_REQUEST_TYPE=OpenAI

WIKI_CONTENT_MODEL=gpt-4o
WIKI_CONTENT_ENDPOINT=https://api.openai.com/v1
WIKI_CONTENT_API_KEY=your-content-api-key
WIKI_CONTENT_REQUEST_TYPE=OpenAI

WIKI_PARALLEL_COUNT=5
WIKI_LANGUAGES=en,zh,zh-tw,ja,ko,es,fr,de,pt-br,pl,ru,ar

# --- Semantic doc search for MCP (embeddings) ---
# OpenAI-compatible API base; empty disables semantic search (compose default: bundled service)
# EMBEDDING_ENDPOINT=http://embeddings:80/v1
# Model name sent to the API and stored with the vectors
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Optional bearer token for the embeddings API
# Только EMBEDDING_ENDPOINT и EMBEDDING_MODEL передаются в контейнер через compose.yaml;
# остальные EMBEDDING_* задавайте в compose.override.yaml (префиксы с пробелом на конце — в кавычках).
# EMBEDDING_API_KEY=
# Prefix added to search queries (e5 models expect "query: ")
# EMBEDDING_QUERY_PREFIX="query: "
# Prefix added to document chunks (e5 models expect "passage: ")
# EMBEDDING_DOCUMENT_PREFIX="passage: "
# Seconds between indexing passes of the background worker
# EMBEDDING_INDEX_INTERVAL_SECONDS=30
# Chunks sent in one embeddings request
# EMBEDDING_BATCH_SIZE=32
